# Server Configuration
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://postgres:1234@localhost:5432/cloudcrest_db

# Authentication Secret
JWT_SECRET=your-jwt-secret-key

# Comma-separated browser origins allowed by CORS in production
# e.g. https://app.cloudcrest.com,https://cloudcrest.com
CORS_ORIGINS=

# Vercel Blob file storage. Create a Blob store in the Vercel dashboard
# (Storage -> Blob) and paste its read-write token here. When unset, uploads
# fall back to the local ./uploads folder for development.
BLOB_READ_WRITE_TOKEN=
